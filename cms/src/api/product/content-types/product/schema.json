{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "A product listed in the storefront catalogue"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["peces", "alimento", "equipos", "plantas"],
      "required": true
    },
    "water": {
      "type": "enumeration",
      "enum": ["dulce", "salada"]
    },
    "subtitle": {
      "type": "string"
    },
    "price": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "compareAt": {
      "type": "decimal",
      "min": 0
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "icon": {
      "type": "enumeration",
      "enum": [
        "fish-symbol",
        "waves",
        "thermometer",
        "flask-conical",
        "leaf",
        "wrench",
        "box"
      ]
    },
    "badgeLabel": {
      "type": "string"
    },
    "badgeTone": {
      "type": "enumeration",
      "enum": ["tide", "coral", "bronze", "kelp", "neutral"]
    },
    "specs": {
      "type": "component",
      "component": "shared.spec",
      "repeatable": true
    },
    "beginner": {
      "type": "boolean",
      "default": false
    },
    "inStock": {
      "type": "boolean",
      "default": true
    },
    "temp": {
      "type": "string"
    },
    "ph": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "mates": {
      "type": "string"
    }
  }
}
