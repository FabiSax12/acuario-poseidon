HOST=0.0.0.0
PORT=1337

# Secrets. Every value must be set to its own random string before Strapi will
# start; in production it also refuses the old "toBeModified" placeholders.
# Generate one with:  openssl rand -base64 32
# APP_KEYS takes four of them, comma-separated.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database (SQLite for local development)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
