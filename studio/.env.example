# Copy to .env and fill in. `sanity dev`, `sanity build`, `sanity deploy` and
# `pnpm seed` all read this file.

# Project id from https://www.sanity.io/manage (or `sanity projects list`).
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Optional. Hostname of the hosted Studio (<hostname>.sanity.studio) and the
# app id that `sanity deploy` prints after the first deploy. With both set,
# later deploys do not ask anything.
SANITY_STUDIO_HOSTNAME=
SANITY_STUDIO_APP_ID=

# Only for `pnpm seed`. A token with the Editor role, created with
# `pnpm exec sanity tokens create "Seed" --role=editor`. Keep it out of Vercel
# and out of git; the storefront reads the public dataset without a token.
SANITY_WRITE_TOKEN=
