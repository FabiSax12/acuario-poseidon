{
  "name": "studio",
  "version": "0.1.0",
  "private": true,
  "description": "Sanity Studio for the Acuario Poseidón storefront catalogue",
  "type": "module",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "dev": "sanity dev",
    "seed": "node --env-file-if-exists=.env scripts/seed.mts",
    "start": "sanity start",
    "test": "node --test \"scripts/**/*.test.mts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/client": "^8.9.0",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "sanity": "^6.17.0",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
