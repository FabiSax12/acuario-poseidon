# Copy to .env.local and fill in. Variables prefixed with VITE_ are included in
# the browser bundle; keep secrets unprefixed so they stay on the server.

# Strapi (server-only). Base URL without /api, and the read-only API token
# created with `pnpm token` in cms/ or in the Strapi admin panel.
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=

# Sentry
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
