# Copy to .env.local and fill in. Variables prefixed with VITE_ are included in
# the browser bundle; keep secrets unprefixed so they stay on the server.

# Sanity (server-only). Project id and dataset of the catalogue; see
# studio/README.md. The dataset is public, so the storefront needs no token.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Optional. Dated API version (YYYY-MM-DD); defaults to the one pinned in
# src/data/sanity-client.ts.
SANITY_API_VERSION=

# Sentry
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
